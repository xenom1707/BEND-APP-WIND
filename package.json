{
  "name": "bend-calculator",
  "version": "3.0.0",
  "description": "Bend Calculator V3",
  "main": "main.js",
  "author": "Shivanov",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.shivanov.bendcalculator",
    "productName": "Bend Calculator",
    "files": ["main.js", "app/**/*"],
    "win": {"target": ["portable"]},
    "artifactName": "Bend-Calculator-V3-${version}.${ext}"
  }
}
